        <mxCell id="c_skill" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#0F172A;margin-bottom:4px;&quot;&gt;SKILL.md Installer&lt;span style=&quot;display:inline-block;margin-left:8px;padding:1px 7px;border-radius:4px;background:#F1F5F9;border:1px solid #CBD5E1;color:#475569;font-size:10.5px;font-weight:normal;&quot;&gt;Detaches after setup&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#475569;&quot;&gt;doctor read-only scan · 3-way migration (Translate / Keep / Ignore) · deploys runtime rules&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fontFamily=Microsoft YaHei,Segoe UI,Arial,sans-serif;" vertex="1" parent="b1">
