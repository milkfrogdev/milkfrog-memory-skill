        <mxCell id="c_cfg" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#0F172A;margin-bottom:4px;&quot;&gt;config.json 策略开关&lt;span style=&quot;display:inline-block;margin-left:8px;padding:1px 7px;border-radius:4px;background:#F1F5F9;border:1px solid #CBD5E1;color:#475569;font-size:10.5px;font-weight:normal;&quot;&gt;兼容旧版 JSON&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#475569;&quot;&gt;双层 / 纯索引 · 24KB / extended 档 · 定时开关 · 跨端导出 · 忽略列表&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fontFamily=Microsoft YaHei,Segoe UI,Arial,sans-serif;" vertex="1" parent="b1">
