        <mxCell id="e_skill_cfg" value="写入开关" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Microsoft YaHei,Segoe UI,Arial,sans-serif;fontSize=11;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c_skill" target="c_cfg">
          <mxGeometry relative="1" as="geometry">
