        </mxCell>
        <mxCell id="mode_dual" value="&lt;b&gt;双层热缓存模式（&lt;code&gt;agents_cache_enabled = true&lt;/code&gt;）&lt;/b&gt;&lt;br&gt;核心底座 + 右侧增量同步；开局直读蒸馏规范，支持阶段 1-&amp;gt;2 增量更新、可选定时与单向跨端导出。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8F6;strokeColor=#E8503A;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;fontFamily=Microsoft YaHei,Segoe UI,Arial,sans-serif;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1">
