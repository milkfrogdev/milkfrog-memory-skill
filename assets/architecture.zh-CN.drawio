        <mxCell id="st1_box" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#0F172A;margin-bottom:4px;&quot;&gt;阶段 1 · 工作区同步&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#475569;&quot;&gt;sync-plan -&amp;gt; apply --scope ws&lt;br&gt;输出 [NEW] / [MOD] / [DEL]&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F1B5AC;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fontFamily=Microsoft YaHei,Segoe UI,Arial,sans-serif;" vertex="1" parent="stage_grp">
